// spawn-at-startup "waybar"  // replaced by the Quickshell bar
spawn-at-startup "awww-daemon"
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
// software renderer: the bar needs no GPU, and the Mesa/LLVM/nvidia stack
// it otherwise loads for shader compilation costs ~300 MB of RAM
spawn-at-startup "env" "QT_QUICK_BACKEND=software" "quickshell"
