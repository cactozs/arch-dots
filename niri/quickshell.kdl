// Generated by quickshell (services/SystemTheme.qml) — edits are overwritten.

layout {
    focus-ring {
        active-gradient from="#fe801966" to="#b8bb2666" angle=180
        inactive-gradient from="#a89984b3" to="#282828b3" angle=45 relative-to="workspace-view"
    }

    border {
        active-color "#fe8019ff"
        inactive-color "#fe801959"
        urgent-color "#fb4934ff"
        active-gradient from="#fe801966" to="#b8bb2666" angle=150
        inactive-gradient from="#a89984b3" to="#282828b3" angle=150
    }
}