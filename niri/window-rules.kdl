// https://niri-wm.github.io/niri/Configuration:-Window-Rules

window-rule {
    clip-to-geometry true
    opacity 0.985
    draw-border-with-background false
    background-effect {
        blur true
    }
}

window-rule {
	match app-id="helium"
	match app-id="ai.storyteller.figcraft"
	opacity 1.0
	background-effect {
        blur false
    }
}

window-rule {
    match app-id="brave-browser-nightly"
    open-maximized-to-edges true
}

blur {
    passes 4
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

animations {
    slowdown 1.0
}
